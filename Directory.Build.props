<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Authors>Jakob Boman</Authors>
    <Copyright>Copyright (c) Jakob Boman</Copyright>
  </PropertyGroup>

  <!--
    No vulnerable package, direct or transitive, gets into what StyleBro builds or ships: every restore audits the whole
    graph and a known vulnerability of any severity fails it (docs/decisions/2026-11-06-vulnerable-packages-fail-every-build.md).
    NU1905 (the audit source can't be read) stays a warning, so an offline restore still works. Fix a finding with a
    bump or a pin in Directory.Packages.props that names the advisory, never with a suppression. This file reaches only
    this repository's projects: samples/StyleCopMigration and .trials/ have props of their own that stop it, and the
    fixture, real-world and verify-package runs work outside the repository, so third-party repositories' own
    dependencies are audited by their own settings. .github/workflows/vulnerable-packages.yml lists findings weekly.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!--
    StyleBro checks its own code with its latest published release from nuget.org (StyleBroSelfVersion), not the code
    being built. Left out: the samples (their input is deliberately messy and is checked by the analyzers being built,
    see scripts/verify-format.ps1) and StyleBro.Package, which is that package and has no code. The analyzer and
    code-fix projects are referenced by StyleBro.Package, so a PackageReference there would be a restore cycle
    (StyleBro.Analyzers -> ... -> StyleBro.Analyzers); they download the package instead and load it in
    Directory.Build.targets.
  -->
  <PropertyGroup>
    <StyleBroSelfVersion>0.8.0-alpha.1</StyleBroSelfVersion>
    <!-- Every rule, also those of minors newer than the default preset (docs/versioning.md). -->
    <StyleBroPreset>latest</StyleBroPreset>
    <!-- StyleBroSelf=none from outside (scripts/verify-format.ps1) turns the self-check off everywhere. -->
    <StyleBroSelf Condition="'$(StyleBroSelf)' == '' and ('$(MSBuildProjectName)' == 'StyleBro.Analyzers' or '$(MSBuildProjectName)' == 'StyleBro.CodeFixes')">download</StyleBroSelf>
    <StyleBroSelf Condition="'$(MSBuildProjectName)' == 'Messy' or '$(MSBuildProjectName)' == 'MultiTarget' or '$(MSBuildProjectName)' == 'StyleBro.Package'">none</StyleBroSelf>
  </PropertyGroup>
  <ItemGroup Condition="'$(StyleBroSelf)' == ''">
    <PackageReference Include="StyleBro.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(StyleBroSelf)' == 'download'">
    <PackageDownload Include="StyleBro.Analyzers" Version="[$(StyleBroSelfVersion)]" />
  </ItemGroup>
</Project>
