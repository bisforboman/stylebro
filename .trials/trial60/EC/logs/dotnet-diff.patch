+                    Name = "Name2",
+                    Lastname = "Lastname2"
+                }
+            };
+            prod.Inner.Inner = prod;
+
+            // redis cache
+            var rCache = factory.GetCachingProvider("r1");
+            rCache.Set<Product>("mkey1", prod, TimeSpan.FromSeconds(20));
