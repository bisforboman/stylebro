+        }
+
+        public async Task<long> TTLAsync(string cacheKey)
+        {
+            ArgumentCheck.NotNullOrWhiteSpace(cacheKey, nameof(cacheKey));
+
+            var ts = await _cache.KeyTimeToLiveAsync(cacheKey);
+            return ts.HasValue ? (long)ts.Value.TotalSeconds : -1;
+        }
