+dotnet_diagnostic.IDE2002.severity = none
+dotnet_diagnostic.IDE2003.severity = none
+# 'this.' qualification isn't required (SA1101 is off in the preset)
+dotnet_diagnostic.IDE0009.severity = none
+
+# Conventions in this repository's code (stylebro-migrate init counted them; delete a line to have it counted again)
+# init: private fields: named '_field' in 78 of 78 places in your code
+stylebro_private_field_naming = _camelCase
+# init: '{' of multi-line blocks: at the end of the line in 1071 of 1303 places in your code
+csharp_new_line_before_open_brace = none
+# init: one-line if/else/loop/using/lock bodies: without braces in 275 of 289 places in your code
+csharp_prefer_braces = when_multiline
+# init: one-line jumps ('if (x) return;'): allowed, because your code has some (37 of 40 places on the 'if' line without braces; any 3 keep them allowed: without it BRO1514 would add braces to each)
+stylebro_allow_single_line_jump_statements = true
