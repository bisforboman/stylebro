+                            if (match.Success)
+                            {
+                                return Tuple.Create(
+                                    match.Groups["ClassName"].Value,
+                                    match.Groups["ClassName"].Value + match.Groups["GenericTypes"].Value);
+                            }
+                        }
+
+                        return Tuple.Create(fullname, fullname);
