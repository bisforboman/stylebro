--- a/.editorconfig
+++ b/.editorconfig
@@ -37,3 +37,55 @@ end_of_line                                                               = lf
 [packages.lock.json]
 end_of_line                                                               = unset
 insert_final_newline                                                      = unset
+
+# BEGIN stylebro-migrate (stylebro-migrate init: built-in .NET rules for StyleBro's preset; edits inside are replaced)
+[*.cs]
+# Built-in .NET rules that cover StyleCop rules, at the preset's severities. Their options (brace placement, modifier
+# order, ...) come from StyleBro's preset. The severities have to be here: 'dotnet format' ignores rule severities in a
+# package's global config. Add <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild> to report them on build too.
+
+# Braces (SA1503, SA1519, SA1520) are StyleBro's BRO1514-BRO1516: IDE0011's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0011.severity = none
+# Formatting: spacing, indentation, line breaks (SA1000-SA1028, SA1107, SA1134, SA1137, SA1500)
+dotnet_diagnostic.IDE0055.severity = warning
+# Access modifiers (SA1400, SA1205) are StyleBro's BRO1404/BRO1007: IDE0040's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0040.severity = none
+# Modifier order: access modifier first, then static (SA1206, SA1207)
+dotnet_diagnostic.IDE0036.severity = warning
+# 'int' instead of 'Int32' (SA1121)
+dotnet_diagnostic.IDE0049.severity = warning
+# Unnecessary parentheses (SA1119) are StyleBro's BRO1405: IDE0047's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0047.severity = none
+# Parentheses that show precedence (SA1407, SA1408) are StyleBro's BRO1406/BRO1407: IDE0048's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0048.severity = none
+# Using placement (SA1200) is StyleBro's BRO1008: IDE0065's fix can change what names bind to (CS0104, CS0118)
+dotnet_diagnostic.IDE0065.severity = none
+# Blank lines (SA1507, SA1508, SA1513) are StyleBro's BRO1517-BRO1519: the SDK's fixes break multi-targeted projects
+dotnet_diagnostic.IDE2000.severity = none
+dotnet_diagnostic.IDE2002.severity = none
+dotnet_diagnostic.IDE2003.severity = none
+# 'this.' qualification isn't required (SA1101 is off in the preset)
+dotnet_diagnostic.IDE0009.severity = none
+
+# Conventions in this repository's code (stylebro-migrate init counted them; delete a line to have it counted again)
+# init: private fields: named '_field' in 6 of 6 places in your code
+stylebro_private_field_naming = _camelCase
+# init: empty strings: "" in 75 of 75 places in your code
+stylebro_empty_string_style = literal
+# init: null checks: your code mixes both forms (1 'is null', 5 '== null'), so BRO1133 is off. To choose one: set stylebro_null_check_style and remove the next line.
+dotnet_diagnostic.BRO1133.severity = none
+# init: default values: 'default' in 3 of 3 places in your code
+csharp_prefer_simple_default_expression = true
+# init: ': base(...)'/': this(...)': on the constructor's line in 4 of 4 places in your code
+stylebro_constructor_initializer_placement = same_line
+# init: switch sections: without a blank line in 25 of 25 places in your code
+stylebro_blank_line_between_switch_sections = omit
+# init: overrides/interface implementations: 4 of 4 in your code are without a doc comment, so BRO1601 is off. To turn it on: remove the next line.
+dotnet_diagnostic.BRO1601.severity = none
+# init: overloads BRO1001 could split: next to each other in 4 of 4 places in your code
+stylebro_keep_overloads_together = true
+# init: property summaries: your code mixes both forms (25 starting with 'Gets'/'Sets', 16 in their own words), so BRO1604 is off. To choose one: set dotnet_diagnostic.BRO1604.severity and remove the next line.
+dotnet_diagnostic.BRO1604.severity = none
+# init: keywords in doc comments: 25 of 25 in your code are '<c>null</c>', so BRO1618 is off. To turn it on: remove the next line.
+dotnet_diagnostic.BRO1618.severity = none
+# END stylebro-migrate
