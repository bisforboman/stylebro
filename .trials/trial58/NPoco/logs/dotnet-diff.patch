+            => "datetime(" + value + ", " + increment + " || ' " + part.ToString().ToLowerInvariant() + "')";
+    }
+
+    public class MySqlSqlDialect : SqlDialect
+    {
+        public static readonly MySqlSqlDialect Instance = new MySqlSqlDialect();
