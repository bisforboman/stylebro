+# BEGIN stylebro-migrate (stylebro-migrate init: built-in .NET rules for StyleBro's preset; edits inside are replaced)
+[*.cs]
+# Built-in .NET rules that cover StyleCop rules, at the preset's severities. Their options (brace placement, modifier
+# order, ...) come from StyleBro's preset. The severities have to be here: 'dotnet format' ignores rule severities in a
+# package's global config. Add <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild> to report them on build too.
+
+# Braces (SA1503, SA1519, SA1520) are StyleBro's BRO1514-BRO1516: IDE0011's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0011.severity = none
+# Formatting: spacing, indentation, line breaks (SA1000-SA1028, SA1107, SA1134, SA1137, SA1500)
+dotnet_diagnostic.IDE0055.severity = warning
+# Access modifiers (SA1400, SA1205) are StyleBro's BRO1404/BRO1007: IDE0040's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0040.severity = none
+# Modifier order: access modifier first, then static (SA1206, SA1207)
+dotnet_diagnostic.IDE0036.severity = warning
+# 'int' instead of 'Int32' (SA1121)
+dotnet_diagnostic.IDE0049.severity = warning
+# Unnecessary parentheses (SA1119) are StyleBro's BRO1405: IDE0047's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0047.severity = none
+# Parentheses that show precedence (SA1407, SA1408) are StyleBro's BRO1406/BRO1407: IDE0048's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0048.severity = none
+# Using placement (SA1200) is StyleBro's BRO1008: IDE0065's fix can change what names bind to (CS0104, CS0118)
+dotnet_diagnostic.IDE0065.severity = none
+# Blank lines (SA1507, SA1508, SA1513) are StyleBro's BRO1517-BRO1519: the SDK's fixes break multi-targeted projects
+dotnet_diagnostic.IDE2000.severity = none
+dotnet_diagnostic.IDE2002.severity = none
+dotnet_diagnostic.IDE2003.severity = none
+# 'this.' qualification isn't required (SA1101 is off in the preset)
+dotnet_diagnostic.IDE0009.severity = none
+
+# Conventions in this repository's code (stylebro-migrate init counted them; delete a line to have it counted again)
+# init: private fields: named '_field' in 38 of 40 places in your code
+stylebro_private_field_naming = _camelCase
+# init: one-line if/else/loop/using/lock bodies: your code mixes both forms (57 with braces, 55 without braces), so both are allowed. To choose with braces: change the next line to csharp_prefer_braces = true.
+csharp_prefer_braces = when_multiline
+# init: one-line jumps ('if (x) return;'): allowed, because your code has some (18 of 46 places on the 'if' line without braces; any 3 keep them allowed: without it BRO1514 would add braces to each)
+stylebro_allow_single_line_jump_statements = true
+# init: operators where a line wraps: your code mixes both forms (17 at the start of the line, 15 at the end of the line), so BRO1520 is off. To choose one: set dotnet_style_operator_placement_when_wrapping and remove the next line.
+dotnet_diagnostic.BRO1520.severity = none
+# init: '=>' where a line wraps: at the start of the line in 21 of 24 places in your code
+stylebro_arrow_placement_when_wrapping = beginning_of_line
+# init: multi-line initializers: your code mixes both forms (16 with a trailing comma, 13 without a trailing comma), so BRO1401 is off. To choose one: set stylebro_trailing_comma and remove the next line.
+dotnet_diagnostic.BRO1401.severity = none
+# init: empty strings: your code mixes both forms (1 string.Empty, 8 ""), so BRO1106 is off. To choose one: set stylebro_empty_string_style and remove the next line.
+dotnet_diagnostic.BRO1106.severity = none
+# init: null checks: '== null' in 61 of 70 places in your code
+stylebro_null_check_style = equality_operator
+# init: ': base(...)'/': this(...)': on the constructor's line in 3 of 3 places in your code
+stylebro_constructor_initializer_placement = same_line
+# init: statements on their 'if'/loop/'case' line: allowed, because your code has some (22 of 57 places on their owner's line; any 3 keep them allowed: csharp_preserve_single_line_statements = false would move each to a line of its own)
+csharp_preserve_single_line_statements = true
+# init: overrides/interface implementations: 6 of 6 in your code are without a doc comment, so BRO1601 is off. To turn it on: remove the next line.
+dotnet_diagnostic.BRO1601.severity = none
+# init: types' members: your code mixes both forms (18 in BRO1001's order, 31 in another order), so BRO1001 is off. To choose one: set dotnet_diagnostic.BRO1001.severity and remove the next line.
+dotnet_diagnostic.BRO1001.severity = none
+# init: private-by-default members: without 'private' in 131 of 136 members in your code
+dotnet_style_require_accessibility_modifiers = omit_if_default
+# init: internal-by-default types: 24 of 25 in your code are without an access modifier, so BRO1404 is off. To turn it on: remove the next line.
+dotnet_diagnostic.BRO1404.severity = none
+# init: property summaries: 7 of 7 in your code are in their own words, so BRO1604 is off. To turn it on: remove the next line.
+dotnet_diagnostic.BRO1604.severity = none
+# init: empty blocks ('{ }'): your code mixes both forms (2 on two lines, 3 on one line), so both are allowed. To choose on two lines: change the next line to stylebro_allow_empty_single_line_blocks = false.
+stylebro_allow_empty_single_line_blocks = true
+# init: C# files' line endings: LF in 67 of 67 files in your code
+end_of_line = lf
+# init: nested ifs BRO1149 would merge: kept, because your code has some (4 nested ifs; any 3 keep them: BRO1149 would merge each), so BRO1149 is off. To turn it on: remove the next line.
+dotnet_diagnostic.BRO1149.severity = none
+# init: keywords in doc comments: your code mixes both forms (3 '<see langword="null"/>', 2 '<c>null</c>'), so BRO1618 is off. To choose one: set dotnet_diagnostic.BRO1618.severity and remove the next line.
+dotnet_diagnostic.BRO1618.severity = none
+# init: using directives: 44 of 45 files sorted, 16 of 19 with System first
+dotnet_sort_system_directives_first = true
+# END stylebro-migrate
