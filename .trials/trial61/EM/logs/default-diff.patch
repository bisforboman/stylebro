+/// <summary>
+/// Represents an error that occurs when conversion of a cell value to the mapped property type fails.
+/// </summary>
+[Serializable]
+public class ExcelMapperConvertException : Exception
+{
+    /// <summary>
+    /// Gets the original cell value.
