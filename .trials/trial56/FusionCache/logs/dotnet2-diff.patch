+            // LOCK ACQUIRED
+            if (_logger?.IsEnabled(LogLevel.Trace) ?? false)
+                _logger.Log(LogLevel.Trace, "FUSION [N={CacheName} I={CacheInstanceId}] (O={CacheOperationId} K={CacheKey}): [ML] MEMORY LOCK acquired", CacheName, InstanceId, operationId, key);
