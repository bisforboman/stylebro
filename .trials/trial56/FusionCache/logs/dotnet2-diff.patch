+    internal async ValueTask SetTagDataInternalAsync(string tag, long timestamp, FusionCacheEntryOptions options, CancellationToken token)
+    {
+        await SetAsync(
+            GetTagCacheKey(tag),
+            timestamp,
+            options,
+            FusionCacheInternalUtils.NoTags,
+            token
+        ).ConfigureAwait(false);
+    }
