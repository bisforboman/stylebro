+
+        // SAFETY NET (BUT IT SHOULD NOT HAPPEN)
+        if (string.IsNullOrWhiteSpace(prefix))
+            prefix = FusionCacheOptions.DefaultCacheName;
+
+        return $"{prefix}{options.InternalStrings.BackplaneChannelNameSeparator}Backplane{options.InternalStrings.BackplaneWireFormatSeparator}{FusionCacheOptions.BackplaneWireFormatVersion}";
+    }
