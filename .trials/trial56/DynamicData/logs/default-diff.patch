-                        break;
-                }
-            }
-        });
-
-        return invokeOnUnsubscribe
-            ? Observable.Create<IChangeSet<T>>(observer =>
-            {
-                var items = new List<T>();
-
-                return removalProcessor
-                    .Do(changeSet => items.Clone(changeSet))
-                    .Finally(() =>
