+root = true
+
+# BEGIN stylebro-migrate (stylebro-migrate init: built-in .NET rules for StyleBro's preset; edits inside are replaced)
+[*.cs]
+# Built-in .NET rules that cover StyleCop rules, at the preset's severities. Their options (brace placement, modifier
+# order, ...) come from StyleBro's preset. The severities have to be here: 'dotnet format' ignores rule severities in a
+# package's global config. Add <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild> to report them on build too.
+
+# Braces (SA1503, SA1519, SA1520) are StyleBro's BRO1514-BRO1516: IDE0011's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0011.severity = none
+# Formatting: spacing, indentation, line breaks (SA1000-SA1028, SA1107, SA1134, SA1137, SA1500)
+dotnet_diagnostic.IDE0055.severity = warning
+# Access modifiers (SA1400, SA1205) are StyleBro's BRO1404/BRO1007: IDE0040's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0040.severity = none
+# Modifier order: access modifier first, then static (SA1206, SA1207)
+dotnet_diagnostic.IDE0036.severity = warning
+# 'int' instead of 'Int32' (SA1121)
+dotnet_diagnostic.IDE0049.severity = warning
+# Unnecessary parentheses (SA1119) are StyleBro's BRO1405: IDE0047's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0047.severity = none
+# Parentheses that show precedence (SA1407, SA1408) are StyleBro's BRO1406/BRO1407: IDE0048's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0048.severity = none
+# Using placement (SA1200) is StyleBro's BRO1008: IDE0065's fix can change what names bind to (CS0104, CS0118)
+dotnet_diagnostic.IDE0065.severity = none
+# Blank lines (SA1507, SA1508, SA1513) are StyleBro's BRO1517-BRO1519: the SDK's fixes break multi-targeted projects
+dotnet_diagnostic.IDE2000.severity = none
+dotnet_diagnostic.IDE2002.severity = none
+dotnet_diagnostic.IDE2003.severity = none
+# 'this.' qualification isn't required (SA1101 is off in the preset)
+dotnet_diagnostic.IDE0009.severity = none
+
+# Conventions in this repository's code (stylebro-migrate init counted them; delete a line to have it counted again)
+# init: private fields: named '_field' in 99 of 103 places in your code
+stylebro_private_field_naming = _camelCase
+# init: one-line jumps ('if (x) return;'): allowed, because your code has some (9 of 205 places on the 'if' line without braces; any 3 keep them allowed: without it BRO1514 would add braces to each)
+stylebro_allow_single_line_jump_statements = true
+# init: multi-line initializers: without a trailing comma in 121 of 142 places in your code
+stylebro_trailing_comma = omit
+# init: null checks: '== null' in 215 of 227 places in your code
+stylebro_null_check_style = equality_operator
+# init: default values: 'default' in 18 of 20 places in your code
+csharp_prefer_simple_default_expression = true
+# init: ')' of split lists: your code mixes both forms (56 after the last item, 21 on its own line), so BRO1110 is off. To choose one: set stylebro_closing_parenthesis_placement and remove the next line.
+dotnet_diagnostic.BRO1110.severity = none
+# init: ': base(...)'/': this(...)': your code mixes both forms (11 on its own line, 15 on the constructor's line), so BRO1105 is off. To choose one: set stylebro_constructor_initializer_placement and remove the next line.
+dotnet_diagnostic.BRO1105.severity = none
+# init: mixed arithmetic ('a + b * c'): without parentheses in 3 of 3 places in your code
+dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary
+# init: statements on their 'if'/loop/'case' line: allowed, because your code has some (9 of 145 places on their owner's line; any 3 keep them allowed: csharp_preserve_single_line_statements = false would move each to a line of its own)
+csharp_preserve_single_line_statements = true
+# init: types' members: your code mixes both forms (61 in BRO1001's order, 93 in another order), so BRO1001 is off. To choose one: set dotnet_diagnostic.BRO1001.severity and remove the next line.
+dotnet_diagnostic.BRO1001.severity = none
+# init: overloads BRO1001 could split: next to each other in 4 of 4 places in your code
+stylebro_keep_overloads_together = true
+# init: split lists' items: your code mixes both forms (29 one per line, 22 grouped on lines), so BRO1108 is off. To choose one: set dotnet_diagnostic.BRO1108.severity and remove the next line.
+dotnet_diagnostic.BRO1108.severity = none
+# init: unsigned literal suffixes: 16 of 16 in your code are lower case ('0u', '1ul'), so BRO1135 is off. To turn it on: remove the next line.
+dotnet_diagnostic.BRO1135.severity = none
+# init: property summaries: your code mixes both forms (10 starting with 'Gets'/'Sets', 8 in their own words), so BRO1604 is off. To choose one: set dotnet_diagnostic.BRO1604.severity and remove the next line.
+dotnet_diagnostic.BRO1604.severity = none
+# init: private static fields: your code mixes both forms (6 without a prefix, 4 with an 's_'/'t_' prefix), so BRO1307 is off. To choose one: set dotnet_diagnostic.BRO1307.severity and remove the next line.
+dotnet_diagnostic.BRO1307.severity = none
+# init: C# files' line endings: LF in 160 of 160 files in your code
+end_of_line = lf
+# init: non-private fields: your code mixes both forms (28 PascalCase or as your naming rule says, 10 named otherwise), so BRO1306 is off. To choose one: set dotnet_diagnostic.BRO1306.severity and remove the next line.
+dotnet_diagnostic.BRO1306.severity = none
