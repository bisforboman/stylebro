diff --git a/.editorconfig b/.editorconfig
index a853ae9..2521b9a 100644
--- a/.editorconfig
+++ b/.editorconfig
@@ -20,3 +20,76 @@ end_of_line = crlf
 csharp_style_namespace_declarations = file_scoped:suggestion
 
 csharp_style_prefer_switch_expression = true:suggestion
+
+# BEGIN stylebro-migrate (stylebro-migrate init: built-in .NET rules for StyleBro's preset; edits inside are replaced)
+[*.cs]
+# Built-in .NET rules that cover StyleCop rules, at the preset's severities. Their options (brace placement, modifier
+# order, ...) come from StyleBro's preset. The severities have to be here: 'dotnet format' ignores rule severities in a
+# package's global config. Add <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild> to report them on build too.
+
+# Braces (SA1503, SA1519, SA1520) are StyleBro's BRO1514-BRO1516: IDE0011's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0011.severity = none
+# Formatting: spacing, indentation, line breaks (SA1000-SA1028, SA1107, SA1134, SA1137, SA1500)
+dotnet_diagnostic.IDE0055.severity = warning
+# Access modifiers (SA1400, SA1205) are StyleBro's BRO1404/BRO1007: IDE0040's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0040.severity = none
+# Modifier order: access modifier first, then static (SA1206, SA1207)
+dotnet_diagnostic.IDE0036.severity = warning
+# 'int' instead of 'Int32' (SA1121)
+dotnet_diagnostic.IDE0049.severity = warning
+# Unnecessary parentheses (SA1119) are StyleBro's BRO1405: IDE0047's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0047.severity = none
+# Parentheses that show precedence (SA1407, SA1408) are StyleBro's BRO1406/BRO1407: IDE0048's fix breaks multi-targeted projects
+dotnet_diagnostic.IDE0048.severity = none
+# Using placement (SA1200) is StyleBro's BRO1008: IDE0065's fix can change what names bind to (CS0104, CS0118)
+dotnet_diagnostic.IDE0065.severity = none
+# Blank lines (SA1507, SA1508, SA1513) are StyleBro's BRO1517-BRO1519: the SDK's fixes break multi-targeted projects
+dotnet_diagnostic.IDE2000.severity = none
+dotnet_diagnostic.IDE2002.severity = none
+dotnet_diagnostic.IDE2003.severity = none
+# 'this.' qualification isn't required (SA1101 is off in the preset)
+dotnet_diagnostic.IDE0009.severity = none
+
+# Conventions in this repository's code (stylebro-migrate init counted them; delete a line to have it counted again)
+# init: private fields: named '_field' in 54 of 54 places in your code
+stylebro_private_field_naming = _camelCase
+# init: one-line if/else/loop/using/lock bodies: your code mixes both forms (48 with braces, 59 without braces), so both are allowed. To choose with braces: change the next line to csharp_prefer_braces = true.
+csharp_prefer_braces = when_multiline
+# init: one-line jumps ('if (x) return;'): allowed, because your code has some (39 of 44 places on the 'if' line without braces; any 3 keep them allowed: without it BRO1514 would add braces to each)
+stylebro_allow_single_line_jump_statements = true
+# init: operators where a line wraps: at the end of the line in 12 of 14 places in your code
+dotnet_style_operator_placement_when_wrapping = end_of_line
+# init: multi-line initializers: without a trailing comma in 5 of 5 places in your code
+stylebro_trailing_comma = omit
+# init: empty strings: "" in 3 of 3 places in your code
+stylebro_empty_string_style = literal
+# init: null checks: '== null' in 50 of 50 places in your code
+stylebro_null_check_style = equality_operator
+# init: <inheritdoc/> tags: '<inheritdoc />' in 12 of 12 places in your code
+stylebro_inheritdoc_style = spaced
+# init: statements on their 'if'/loop/'case' line: allowed, because your code has some (39 of 59 places on their owner's line; any 3 keep them allowed: csharp_preserve_single_line_statements = false would move each to a line of its own)
+csharp_preserve_single_line_statements = true
+# init: overrides/interface implementations: 20 of 21 in your code are without a doc comment, so BRO1601 is off. To turn it on: remove the next line.
+dotnet_diagnostic.BRO1601.severity = none
+# init: types' members: your code mixes both forms (20 in BRO1001's order, 11 in another order), so BRO1001 is off. To choose one: set dotnet_diagnostic.BRO1001.severity and remove the next line.
+dotnet_diagnostic.BRO1001.severity = none
+# init: private-by-default members: without 'private' in 95 of 96 members in your code
+dotnet_style_require_accessibility_modifiers = omit_if_default
+# init: internal-by-default types: 21 of 21 in your code are without an access modifier, so BRO1404 is off. To turn it on: remove the next line.
+dotnet_diagnostic.BRO1404.severity = none
+# init: adjacent locals of one type: your code mixes both forms (9 declared one by one, 9 declared together ('int a, b;')), so BRO1142 is off. To choose one: set dotnet_diagnostic.BRO1142.severity and remove the next line.
+dotnet_diagnostic.BRO1142.severity = none
+# init: declarations with 2+ attributes: your code mixes both forms (4 one per list ('[A]' '[B]'), 6 combined ('[A, B]')), so BRO1102 is off. To choose one: set dotnet_diagnostic.BRO1102.severity and remove the next line.
+dotnet_diagnostic.BRO1102.severity = none
+# init: empty blocks ('{ }'): your code mixes both forms (5 on two lines, 2 on one line), so both are allowed. To choose on two lines: change the next line to stylebro_allow_empty_single_line_blocks = false.
+stylebro_allow_empty_single_line_blocks = true
+# init: C# files' line endings: LF in 46 of 46 files in your code
+end_of_line = lf
+# init: '//' comments below code: your code mixes both forms (11 after a blank line, 8 right below the code), so BRO1504 is off. To choose one: set dotnet_diagnostic.BRO1504.severity and remove the next line.
+dotnet_diagnostic.BRO1504.severity = none
+# init: doc element order (param, returns, exception, remarks, example): your code mixes both forms (8 in BRO1619's order, 6 in another order), so BRO1619 is off. To choose one: set dotnet_diagnostic.BRO1619.severity and remove the next line.
+dotnet_diagnostic.BRO1619.severity = none
+# init: using directives: sorted, but with System first and without (21 of 25 files sorted, 4 of 5 with System first), so they aren't sorted ('dotnet format' sorts them whenever dotnet_sort_system_directives_first is set). To sort them: add dotnet_sort_system_directives_first = true
+# init: Charset: your .editorconfig says charset = utf-8, but 26 of 46 C# files start with a BOM: nothing enforced it, so charset = unset is written for C# files and 'format' leaves each file's BOM (or its absence) as it is. To have charset = utf-8 everywhere: put that line below the stylebro-migrate block, in a [*.cs] section (a later line wins; the block's own lines come back on the next init) and run 'bro format' (it rewrites the files).
+charset = unset
+# END stylebro-migrate
