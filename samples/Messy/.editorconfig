# The sample code names private fields '_field', so BRO1303 uses that style here (the default is 'field').
[*.cs]
stylebro_private_field_naming = _camelCase

# BRO1615 (XML file header) for one file only, so the other samples stay header-free.
[**/Ledger.cs]
stylebro_file_header_company = Contoso

# BRO1310 (Hungarian prefixes) is off by default; on for one file.
[**/Hygrometer.cs]
dotnet_diagnostic.BRO1310.severity = warning

# BRO1001 inside regions: BRO1112 (remove regions, off in the preset) stays off here.
[**/Kettle.cs]
dotnet_diagnostic.BRO1112.severity = none

# BRO1133 (null checks) in the '== null' form for one file (Lookups.cs has the default 'is null' form, where 'null == key'
# is BRO1103's too and the two fixes converge in one run).
[**/NullChecks.cs]
stylebro_null_check_style = equality_operator

# Checks.cs shows BRO1103 turning 'null == name' into 'name == null' (with the default, BRO1133 would make it 'name is null').
[**/Checks.cs]
stylebro_null_check_style = equality_operator

# BRO1312 (namespace names) is off by default; on for one file.
[**/Catalog.cs]
dotnet_diagnostic.BRO1312.severity = warning

# BRO1313 (parameter names like the base) and BRO1314 (Async suffix) are off by default; on for one file. The naming
# rules ask BRO1306 for camelCase private constants and _camelCase private static readonly fields.
[**/Uploader.cs]
dotnet_diagnostic.BRO1313.severity = warning
dotnet_diagnostic.BRO1314.severity = warning
dotnet_naming_rule.private_constants.symbols = private_constants
dotnet_naming_rule.private_constants.style = camel
dotnet_naming_rule.private_constants.severity = suggestion
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_rule.private_statics.symbols = private_statics
dotnet_naming_rule.private_statics.style = underscore_camel
dotnet_naming_rule.private_statics.severity = suggestion
dotnet_naming_symbols.private_statics.applicable_kinds = field
dotnet_naming_symbols.private_statics.applicable_accessibilities = private
dotnet_naming_symbols.private_statics.required_modifiers = static, readonly
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
