<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Multi-targeted integration sample for 'dotnet format'. Each target framework has its own copy of every file, and
    '#if' regions make the copies need different fixes. scripts/verify-format.ps1 checks that the fixes merge into one
    clean result (an earlier version wrote merge conflict markers into the source here).
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Generated\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StyleBro.Analyzers\StyleBro.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\StyleBro.CodeFixes\StyleBro.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
