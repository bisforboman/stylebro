is_global = true
global_level = -1

# Follows StyleCop's defaults except where docs/differences-from-stylecop.md says otherwise (test-enforced).

# ---------------------------------------------------------------------------
# StyleBro rules
# ---------------------------------------------------------------------------

# BRO1001: members ordered by kind, accessibility, const/static/readonly (SA1201-SA1204, SA1214)
dotnet_diagnostic.BRO1001.severity = warning
stylebro_member_order = field, constructor, finalizer, delegate, event, enum, interface, property, indexer, conversion, operator, method, struct, class
stylebro_member_access_order = public, internal, protected_internal, protected, private_protected, private
stylebro_member_constants_first = true
stylebro_member_static_first = true
stylebro_member_readonly_first = true

# BRO1002: a space after '//' (SA1005)
dotnet_diagnostic.BRO1002.severity = warning

# BRO1003/BRO1004: 'get' before 'set'/'init', 'add' before 'remove' (SA1212, SA1213)
dotnet_diagnostic.BRO1003.severity = warning
dotnet_diagnostic.BRO1004.severity = warning

# BRO1105: constructor initializers on their own line (SA1128)
dotnet_diagnostic.BRO1105.severity = warning

# BRO1101: no empty statements (SA1106)
dotnet_diagnostic.BRO1101.severity = warning

# BRO1102: each attribute in its own brackets (SA1133)
dotnet_diagnostic.BRO1102.severity = warning

# BRO1103: constants on the right-hand side of comparisons (SA1131)
dotnet_diagnostic.BRO1103.severity = warning

# BRO1104: default instead of a value type's default constructor (SA1129)
dotnet_diagnostic.BRO1104.severity = warning

# BRO1106: string.Empty instead of "" (SA1122)
dotnet_diagnostic.BRO1106.severity = warning

# BRO1107: split parameters start on the line after the parenthesis (SA1116)
dotnet_diagnostic.BRO1107.severity = warning

# BRO1108: parameters all on one line or each on its own line (SA1117)
dotnet_diagnostic.BRO1108.severity = warning

# BRO1301: variable names begin with a lower-case letter (SA1312)
dotnet_diagnostic.BRO1301.severity = warning

# BRO1302: parameter names begin with a lower-case letter (SA1313)
dotnet_diagnostic.BRO1302.severity = warning

# BRO1303: private field names are camelCase (SA1306/SA1309). For '_count' instead of 'count', set
# stylebro_private_field_naming = _camelCase in .editorconfig.
dotnet_diagnostic.BRO1303.severity = warning
stylebro_private_field_naming = camelCase

# BRO1304: interface names begin with I (SA1302)
dotnet_diagnostic.BRO1304.severity = warning

# BRO1305: type parameter names begin with T (SA1314)
dotnet_diagnostic.BRO1305.severity = warning

# BRO1306: constant, static readonly and non-private fields are PascalCase (SA1303, SA1311, SA1307, SA1304)
dotnet_diagnostic.BRO1306.severity = warning

# BRO1307: no m_/s_/t_ prefix on fields (SA1308). Turn off if you follow the .NET runtime's s_/t_ style.
dotnet_diagnostic.BRO1307.severity = warning

# BRO1308: no underscore inside field names (SA1310)
dotnet_diagnostic.BRO1308.severity = warning

# BRO1309: types and members begin with an upper-case letter (SA1300, not namespaces)
dotnet_diagnostic.BRO1309.severity = warning

# BRO1109: opening parenthesis on the declaration line (SA1110)
dotnet_diagnostic.BRO1109.severity = warning

# BRO1110: closing parenthesis on the line of the last item (SA1111)
dotnet_diagnostic.BRO1110.severity = warning

# BRO1111: generic type constraints on their own line (SA1127)
dotnet_diagnostic.BRO1111.severity = warning

# BRO1112: no regions (SA1124). Off (StyleCop has it on): removing every region is a large one-time change; set to warning to opt in.
dotnet_diagnostic.BRO1112.severity = none

# BRO1113: no regions inside code elements (SA1123)
dotnet_diagnostic.BRO1113.severity = warning

# BRO1114: one field per declaration (SA1132)
dotnet_diagnostic.BRO1114.severity = warning

# BRO1115: 'int?' instead of 'Nullable<int>' (SA1125)
dotnet_diagnostic.BRO1115.severity = warning

# BRO1401: trailing comma in multi-line initializers (SA1413)
dotnet_diagnostic.BRO1401.severity = warning

# BRO1402: no empty parentheses on attributes (SA1411)
dotnet_diagnostic.BRO1402.severity = warning

# BRO1601: <inheritdoc/> on undocumented overrides and implementations (SA1600, for these members only). Which members
# need documentation, like stylecop.json's documentationRules (StyleCop's defaults):
dotnet_diagnostic.BRO1601.severity = warning
stylebro_document_exposed_elements = true
stylebro_document_internal_elements = true
stylebro_document_private_elements = false

# BRO1602: '//' instead of '///' for plain comments (SA1626)
dotnet_diagnostic.BRO1602.severity = warning

# BRO1603: documentation text ends with a period (SA1629)
dotnet_diagnostic.BRO1603.severity = warning

# BRO1604/BRO1605: property summaries begin with the accessors' words (SA1623, SA1624)
dotnet_diagnostic.BRO1604.severity = warning
dotnet_diagnostic.BRO1605.severity = warning

# BRO1606/BRO1607: constructor and finalizer summaries begin with the standard text (SA1642, SA1643)
dotnet_diagnostic.BRO1606.severity = warning
dotnet_diagnostic.BRO1607.severity = warning

# BRO1608: no <returns> on void methods (SA1617)
dotnet_diagnostic.BRO1608.severity = warning

# BRO1609: no <placeholder> elements (SA1651)
dotnet_diagnostic.BRO1609.severity = warning

# BRO1610: no empty <remarks> (SA1627)
dotnet_diagnostic.BRO1610.severity = warning

# BRO1611: <param> tags match the parameters (SA1612)
dotnet_diagnostic.BRO1611.severity = warning

# BRO1612/BRO1614: <param> and <typeparam> tags name what they document (SA1613, SA1621)
dotnet_diagnostic.BRO1612.severity = warning
dotnet_diagnostic.BRO1614.severity = warning

# BRO1613: <typeparam> tags match the type parameters (SA1620)
dotnet_diagnostic.BRO1613.severity = warning

# BRO1501: no blank line before an opening brace (SA1509)
dotnet_diagnostic.BRO1501.severity = warning

# BRO1502: no blank line before else, catch or finally (SA1510)
dotnet_diagnostic.BRO1502.severity = warning

# BRO1503: no blank line after an opening brace (SA1505)
dotnet_diagnostic.BRO1503.severity = warning

# BRO1504: a blank line before a comment that follows code (SA1515)
dotnet_diagnostic.BRO1504.severity = warning

# BRO1505: elements separated by a blank line; consecutive fields may stay together (SA1516)
dotnet_diagnostic.BRO1505.severity = warning

# BRO1506: no blank line after a single-line comment (SA1512)
dotnet_diagnostic.BRO1506.severity = warning

# BRO1507: no blank lines at the end of a file (SA1518)
dotnet_diagnostic.BRO1507.severity = warning

# BRO1508: blocks of statements not on a single line (SA1501); lambda bodies may stay on one line
dotnet_diagnostic.BRO1508.severity = warning

# BRO1509: types, members and accessor lists with bodies not on a single line (SA1502); auto-properties
# ('{ get; set; }') are fine
dotnet_diagnostic.BRO1509.severity = warning

# BRO1510: accessors with bodies all single-line or all multi-line (SA1504)
dotnet_diagnostic.BRO1510.severity = warning

# ---------------------------------------------------------------------------
# Built-in .NET rules that already cover common StyleCop rules.
# 'dotnet format' fixes these too. To also enforce them on build, set
# <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild> in the project.
# ---------------------------------------------------------------------------

# Braces on all control statements (SA1503, SA1519, SA1520)
csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = warning

# Formatting (IDE0055): spacing, indentation and line breaks. Covers the spacing rules SA1000-SA1028, SA1134,
# SA1137, and with the line-break settings below SA1500 and SA1107 (verified with
# scripts/stylecop-survey/Test-SdkCoverage.ps1). The SDK keeps single-line blocks: it could expand 'void M() { }' only
# together with every auto-property's '{ get; set; }', which StyleCop allows; BRO1508/BRO1509 expand them instead.
dotnet_diagnostic.IDE0055.severity = warning
csharp_new_line_before_open_brace = all
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# Explicit access modifiers (SA1400), except on interface members, which SA1400 leaves alone
dotnet_style_require_accessibility_modifiers = for_non_interface_members
dotnet_diagnostic.IDE0040.severity = warning

# 'int' and 'string' instead of 'Int32' and 'String' (SA1121)
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true
dotnet_diagnostic.IDE0049.severity = warning

# Parentheses that clarify precedence, and none that don't (SA1407, SA1408, SA1119)
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity
dotnet_style_parentheses_in_other_operators = never_if_unnecessary
dotnet_diagnostic.IDE0047.severity = warning
dotnet_diagnostic.IDE0048.severity = warning

# Using directives: outside the namespace (works with file-scoped namespaces; StyleCop's SA1200 default is
# inside), System first, sorted (SA1208, SA1210, SA1211). Sorting happens in 'dotnet format'.
csharp_using_directive_placement = outside_namespace
dotnet_diagnostic.IDE0065.severity = warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Blank lines (SA1507, SA1508, SA1513). The SDK marks these rules experimental.
dotnet_style_allow_multiple_blank_lines_experimental = false
dotnet_diagnostic.IDE2000.severity = warning
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false
dotnet_diagnostic.IDE2002.severity = warning
dotnet_style_allow_statement_immediately_after_block_experimental = false
dotnet_diagnostic.IDE2003.severity = warning

# 'this.' qualification (SA1101, on in StyleCop): not required, like the SDK default; most teams turn SA1101 off.
# To require it like StyleCop, set these to true and IDE0009 to warning.
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false
dotnet_diagnostic.IDE0009.severity = none

# Not set on purpose (see docs/differences-from-stylecop.md):
# - File headers (SA1633): set file_header_template in your .editorconfig and IDE0073 to warning.
# - Naming (IDE1006): StyleBro's BRO13xx rules cover it, and IDE1006 has no Fix All for 'dotnet format'.
