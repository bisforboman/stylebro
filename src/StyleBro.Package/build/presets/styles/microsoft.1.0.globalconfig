is_global = true
global_level = -1

# The Microsoft style (<StyleBroStyle>microsoft</StyleBroStyle>, docs/styles.md): dotnet/runtime's coding style
# (docs/coding-guidelines/coding-style.md and the root .editorconfig, read at commit 24543ddd), on top of the preset
# layers (global_level -2), so these lines win over the preset's. Rules neither source names follow runtime's build
# (eng/CodeAnalysis.src.globalconfig) through stylebro-migrate's StyleCop mapping; StyleBro's rules beyond StyleCop are
# off. Only what differs from the preset is here. The severities of the built-in rules go into .editorconfig with
# 'stylebro-migrate init --style microsoft' ('dotnet format' ignores severities in a package's global config).
# Using order (dotnet_sort_system_directives_first) isn't set here: init writes it when the code sorts its usings.

# ---------------------------------------------------------------------------
# StyleBro rules
# ---------------------------------------------------------------------------

# Fields at the top of the type, nothing else ordered (guide rule 15)
stylebro_member_order_scope = fields_first

# '_camelCase' private and internal fields, 's_camelCase' private and internal static fields (guide rule 3)
stylebro_private_field_naming = _camelCase
stylebro_internal_field_naming = like_private
stylebro_private_static_field_naming = s_camelCase
stylebro_private_mutable_static_field_naming = s_camelCase

# Off: 'none' in runtime's build (the StyleCop rules they replace)
dotnet_diagnostic.BRO1002.severity = none
dotnet_diagnostic.BRO1005.severity = none
dotnet_diagnostic.BRO1101.severity = none
dotnet_diagnostic.BRO1102.severity = none
dotnet_diagnostic.BRO1103.severity = none
dotnet_diagnostic.BRO1105.severity = none
dotnet_diagnostic.BRO1106.severity = none
dotnet_diagnostic.BRO1107.severity = none
dotnet_diagnostic.BRO1108.severity = none
dotnet_diagnostic.BRO1109.severity = none
dotnet_diagnostic.BRO1110.severity = none
dotnet_diagnostic.BRO1111.severity = none
dotnet_diagnostic.BRO1113.severity = none
dotnet_diagnostic.BRO1114.severity = none
dotnet_diagnostic.BRO1115.severity = none
dotnet_diagnostic.BRO1118.severity = none
dotnet_diagnostic.BRO1120.severity = none
dotnet_diagnostic.BRO1122.severity = none
dotnet_diagnostic.BRO1125.severity = none
dotnet_diagnostic.BRO1126.severity = none
dotnet_diagnostic.BRO1131.severity = none
dotnet_diagnostic.BRO1132.severity = none
dotnet_diagnostic.BRO1301.severity = none
dotnet_diagnostic.BRO1305.severity = none
dotnet_diagnostic.BRO1307.severity = none
dotnet_diagnostic.BRO1308.severity = none
dotnet_diagnostic.BRO1311.severity = none
dotnet_diagnostic.BRO1401.severity = none
dotnet_diagnostic.BRO1405.severity = none
