dotnet_diagnostic.BRO1504.severity = none
dotnet_diagnostic.BRO1505.severity = none
dotnet_diagnostic.BRO1506.severity = none
dotnet_diagnostic.BRO1508.severity = none
dotnet_diagnostic.BRO1509.severity = none
dotnet_diagnostic.BRO1510.severity = none
dotnet_diagnostic.BRO1511.severity = none
dotnet_diagnostic.BRO1513.severity = none
dotnet_diagnostic.BRO1518.severity = none
