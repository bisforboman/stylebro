dotnet_diagnostic.BRO1611.severity = none

# Off: not StyleCop rules, so runtime's build says nothing about them (BRO1133 would also turn the guide's
# 'if (items == null)' into 'is null')
dotnet_diagnostic.BRO1133.severity = none
dotnet_diagnostic.BRO1134.severity = none
dotnet_diagnostic.BRO1135.severity = none
dotnet_diagnostic.BRO1136.severity = none
