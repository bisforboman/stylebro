<Project>
  <!--
    The preset (docs/versioning.md): one global config per minor release, each with only that minor's new rules, so a
    package upgrade never turns rules on by itself. <StyleBroPreset> picks how far up the layers go: X.Y, 'latest', or
    'none' (no preset); unset means the package's major (1.0 in all of 1.x). This is a .targets file (not .props) so a
    StyleBroPreset set in the project file is already visible here.
    The layers are global configs with a low global_level: anything in the project's own .editorconfig or .globalconfig
    wins. No key is in two layers (PresetVersionTests), so they never conflict.
    They go in EditorConfigFiles, not GlobalAnalyzerConfigFiles, and at evaluation time (not in a target): the SDK turns
    GlobalAnalyzerConfigFiles into EditorConfigFiles in Microsoft.Managed.Core.targets, which is evaluated before a
    package's build targets, so an item added that way was never passed to the compiler (alpha.1 to alpha.8). The
    compiler reads them as global (is_global = true).
    A new minor's layer: add the file under presets/, a line below with
    Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_StyleBroPresetLevel)', '1.1'))", and raise _StyleBroPresetLatest
    and StyleBro.Analyzers' PresetVersions.Latest (PresetVersionTests checks that they agree).
  -->
  <PropertyGroup>
    <_StyleBroPresetLatest>1.0</_StyleBroPresetLatest>
    <_StyleBroPresetDefault>1.0</_StyleBroPresetDefault>
    <_StyleBroPresetLevel>$(StyleBroPreset.Trim())</_StyleBroPresetLevel>
    <_StyleBroPresetLevel Condition="'$(_StyleBroPresetLevel)' == ''">$(_StyleBroPresetDefault)</_StyleBroPresetLevel>
    <_StyleBroPresetLevel Condition="'$(_StyleBroPresetLevel)' == 'latest'">$(_StyleBroPresetLatest)</_StyleBroPresetLevel>
    <_StyleBroPresetValid Condition="'$(_StyleBroPresetLevel)' != 'none' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_StyleBroPresetLevel)', '^\d+\.\d+$'))">true</_StyleBroPresetValid>
    <_StyleBroPresetValid Condition="'$(_StyleBroPresetValid)' == 'true' and $([MSBuild]::VersionLessThan('$(_StyleBroPresetLevel)', '$(_StyleBroPresetDefault)'))">false</_StyleBroPresetValid>
  </PropertyGroup>
  <ItemGroup Condition="'$(_StyleBroPresetValid)' == 'true'">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)presets/stylebro.1.0.globalconfig" />
  </ItemGroup>
  <Target Name="_StyleBroCheckPreset" BeforeTargets="CoreCompile" Condition="'$(_StyleBroPresetLevel)' != 'none'">
    <Error Condition="'$(_StyleBroPresetValid)' != 'true'" Code="STYLEBRO001" Text="StyleBroPreset is '$(StyleBroPreset)': use a preset version ($(_StyleBroPresetDefault) up to $(_StyleBroPresetLatest)), 'latest' or 'none'. See https://bisforboman.github.io/stylebro/versioning/#new-rules" />
    <Warning Condition="'$(_StyleBroPresetValid)' == 'true' and $([MSBuild]::VersionGreaterThan('$(_StyleBroPresetLevel)', '$(_StyleBroPresetLatest)'))" Code="STYLEBRO002" Text="StyleBroPreset is $(StyleBroPreset), but this StyleBro.Analyzers package's newest preset is $(_StyleBroPresetLatest): using $(_StyleBroPresetLatest). Upgrade the package or lower the setting." />
  </Target>

  <!--
    The baseline: existing violations that aren't reported (docs/baseline.md). The nearest stylebro.baseline above the
    project, or the file <StyleBroBaseline> names (it must be called stylebro.baseline); 'none' turns it off.
  -->
  <PropertyGroup>
    <StyleBroBaseline Condition="'$(StyleBroBaseline)' == ''">$([MSBuild]::GetPathOfFileAbove('stylebro.baseline', '$(MSBuildProjectDirectory)'))</StyleBroBaseline>
  </PropertyGroup>
  <ItemGroup Condition="'$(StyleBroBaseline)' != '' and '$(StyleBroBaseline)' != 'none' and Exists('$(StyleBroBaseline)')">
    <AdditionalFiles Include="$(StyleBroBaseline)" />
  </ItemGroup>

  <!--
    The multi-target guard (docs/modernizing.md): the project's target frameworks for MultiTargetSuppressor. Inner builds
    still see the full TargetFrameworks list. Comma-separated because ';' starts a comment in the generated editorconfig.
  -->
  <PropertyGroup>
    <StyleBroTargetFrameworks Condition="'$(StyleBroTargetFrameworks)' == '' and '$(TargetFrameworks)' != ''">$(TargetFrameworks.Replace(';', ','))</StyleBroTargetFrameworks>
    <StyleBroTargetFrameworks Condition="'$(StyleBroTargetFrameworks)' == ''">$(TargetFramework)</StyleBroTargetFrameworks>
  </PropertyGroup>
  <!--
    The package folders for PackageFileSuppressor: StyleBro's findings in files compiled from a NuGet package (source
    packages' contentFiles) are hidden, nobody can fix them there. '|'-separated, like StyleBroTargetFrameworks.
  -->
  <PropertyGroup>
    <StyleBroPackageFolders Condition="'$(StyleBroPackageFolders)' == ''">$(NuGetPackageFolders.Replace(';', '|'))</StyleBroPackageFolders>
  </PropertyGroup>
  <!--
    BRO1150 writes List<T>.Exists/Find and Array.Exists/Find where Sonar's S6605/S6602 are on: with no severity configured
    for them, that depends on the SonarAnalyzer.CSharp package's version (on in its defaults before 10.0). Its analyzer
    paths ('|'-separated; the version is in the package folder's path) are passed after the packages' analyzers are
    resolved, so this is a target.
  -->
  <Target Name="_StyleBroFindSonar" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun">
    <ItemGroup>
      <_StyleBroSonarAnalyzer Include="@(Analyzer)" Condition="'%(Filename)' == 'SonarAnalyzer.CSharp'" />
    </ItemGroup>
    <PropertyGroup>
      <StyleBroSonar Condition="'$(StyleBroSonar)' == ''">@(_StyleBroSonarAnalyzer->'%(FullPath)', '|')</StyleBroSonar>
    </PropertyGroup>
  </Target>
  <!--
    The folders source generators write to, for GeneratedFileSuppressor: the compiler puts generated files under the
    intermediate output folder (obj/), or under CompilerGeneratedFilesOutputPath when EmitCompilerGeneratedFiles is on.
    A target, so both paths are final. '|'-separated.
  -->
  <Target Name="_StyleBroFindGeneratedFolders" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun" Condition="'$(StyleBroGeneratedFolders)' == ''">
    <PropertyGroup>
      <StyleBroGeneratedFolders Condition="'$(BaseIntermediateOutputPath)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)'))))</StyleBroGeneratedFolders>
      <StyleBroGeneratedFolders Condition="'$(EmitCompilerGeneratedFiles)' == 'true' and '$(CompilerGeneratedFilesOutputPath)' != ''">$(StyleBroGeneratedFolders)|$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(CompilerGeneratedFilesOutputPath)'))))</StyleBroGeneratedFolders>
    </PropertyGroup>
  </Target>
  <!--
    The repository's git submodules, for PackageFileSuppressor: another repository's code a project compiles (SixLabors'
    shared-infrastructure) can't be fixed here, and 'dotnet format' skips it. Their paths come from the .gitmodules
    nearest above the project. '|'-separated.
  -->
  <Target Name="_StyleBroFindSubmodules" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun" Condition="'$(StyleBroSubmoduleFolders)' == ''">
    <PropertyGroup>
      <_StyleBroGitRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', '.gitmodules'))</_StyleBroGitRoot>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_StyleBroGitRoot)/.gitmodules" Condition="'$(_StyleBroGitRoot)' != ''">
      <Output TaskParameter="Lines" ItemName="_StyleBroGitModulesLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_StyleBroSubmodule Include="$([MSBuild]::NormalizeDirectory('$(_StyleBroGitRoot)', $([System.Text.RegularExpressions.Regex]::Replace('%(_StyleBroGitModulesLine.Identity)', '^\s*path\s*=\s*', '').Trim())))" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_StyleBroGitModulesLine.Identity)', '^\s*path\s*='))" />
    </ItemGroup>
    <PropertyGroup>
      <StyleBroSubmoduleFolders>@(_StyleBroSubmodule, '|')</StyleBroSubmoduleFolders>
    </PropertyGroup>
  </Target>
  <ItemGroup>
    <CompilerVisibleProperty Include="StyleBroSubmoduleFolders" />
    <CompilerVisibleProperty Include="StyleBroGeneratedFolders" />
    <CompilerVisibleProperty Include="StyleBroSonar" />
    <CompilerVisibleProperty Include="StyleBroPackageFolders" />    <CompilerVisibleProperty Include="StyleBroTargetFrameworks" />
    <!-- BRO1145 (C# 12 syntax): the SDK sets LangVersion to MaxSupportedLangVersion unless the project sets it. -->
    <CompilerVisibleProperty Include="LangVersion" />
    <CompilerVisibleProperty Include="MaxSupportedLangVersion" />
    <!-- BRO1601 asks for documentation only where the project generates it (the same in a build and 'dotnet format'). -->
    <CompilerVisibleProperty Include="GenerateDocumentationFile" />
  </ItemGroup>
</Project>
