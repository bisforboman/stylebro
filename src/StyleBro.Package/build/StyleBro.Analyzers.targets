<Project>
  <!--
    The preset (docs/versioning.md): one global config per minor release, each with only that minor's new rules, so a
    package upgrade never turns rules on by itself. <StyleBroPreset> picks how far up the layers go: X.Y, 'latest', or
    'none' (no preset); unset means the package's major (1.0 in all of 1.x). This is a .targets file (not .props) so a
    StyleBroPreset set in the project file is already visible here.
    The layers are global configs with a low global_level: anything in the project's own .editorconfig or .globalconfig
    wins. No key is in two layers (PresetVersionTests), so they never conflict.
    They go in EditorConfigFiles, not GlobalAnalyzerConfigFiles, and at evaluation time (not in a target): the SDK turns
    GlobalAnalyzerConfigFiles into EditorConfigFiles in Microsoft.Managed.Core.targets, which is evaluated before a
    package's build targets, so an item added that way was never passed to the compiler (alpha.1 to alpha.8). The
    compiler reads them as global (is_global = true).
    A new minor's layer: add the file under presets/, a line below with
    Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_StyleBroPresetLevel)', '1.1'))", and raise _StyleBroPresetLatest
    and StyleBro.Analyzers' PresetVersions.Latest (PresetVersionTests checks that they agree).
  -->
  <PropertyGroup>
    <_StyleBroPresetLatest>1.0</_StyleBroPresetLatest>
    <_StyleBroPresetDefault>1.0</_StyleBroPresetDefault>
    <_StyleBroPresetLevel>$(StyleBroPreset.Trim())</_StyleBroPresetLevel>
    <_StyleBroPresetLevel Condition="'$(_StyleBroPresetLevel)' == ''">$(_StyleBroPresetDefault)</_StyleBroPresetLevel>
    <_StyleBroPresetLevel Condition="'$(_StyleBroPresetLevel)' == 'latest'">$(_StyleBroPresetLatest)</_StyleBroPresetLevel>
    <_StyleBroPresetValid Condition="'$(_StyleBroPresetLevel)' != 'none' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_StyleBroPresetLevel)', '^\d+\.\d+$'))">true</_StyleBroPresetValid>
    <_StyleBroPresetValid Condition="'$(_StyleBroPresetValid)' == 'true' and $([MSBuild]::VersionLessThan('$(_StyleBroPresetLevel)', '$(_StyleBroPresetDefault)'))">false</_StyleBroPresetValid>
  </PropertyGroup>
  <ItemGroup Condition="'$(_StyleBroPresetValid)' == 'true'">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)presets/stylebro.1.0.globalconfig" />
  </ItemGroup>
  <!--
    A style (docs/styles.md): 'stylecop' is the preset itself (no layer, the same as unset or 'none');
    <StyleBroStyle>microsoft</StyleBroStyle> adds that style's layers on top of the preset's, one
    per preset minor up to the same level (a style never turns on a rule the chosen preset doesn't have). The preset layers
    are at global_level -2 and the style's at -1, so the style's keys win over the preset's; the project's own .editorconfig
    and .globalconfig still win over both. A new minor's style layer: a line below with the same condition as its preset layer.
  -->
  <PropertyGroup>
    <_StyleBroStyle>$(StyleBroStyle.Trim().ToLowerInvariant())</_StyleBroStyle>
  </PropertyGroup>
  <ItemGroup Condition="'$(_StyleBroPresetValid)' == 'true' and '$(_StyleBroStyle)' == 'microsoft'">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)presets/styles/microsoft.1.0.globalconfig" />
  </ItemGroup>
  <Target Name="_StyleBroCheckPreset" BeforeTargets="CoreCompile">
    <Error Condition="'$(_StyleBroPresetLevel)' != 'none' and '$(_StyleBroPresetValid)' != 'true'" Code="STYLEBRO001" Text="StyleBroPreset is '$(StyleBroPreset)': use a preset version ($(_StyleBroPresetDefault) up to $(_StyleBroPresetLatest)), 'latest' or 'none'. See https://bisforboman.github.io/stylebro/versioning/#new-rules" />
    <Warning Condition="'$(_StyleBroPresetValid)' == 'true' and $([MSBuild]::VersionGreaterThan('$(_StyleBroPresetLevel)', '$(_StyleBroPresetLatest)'))" Code="STYLEBRO002" Text="StyleBroPreset is $(StyleBroPreset), but this StyleBro.Analyzers package's newest preset is $(_StyleBroPresetLatest): using $(_StyleBroPresetLatest). Upgrade the package or lower the setting." />
    <Error Condition="'$(_StyleBroStyle)' != '' and '$(_StyleBroStyle)' != 'none' and '$(_StyleBroStyle)' != 'stylecop' and '$(_StyleBroStyle)' != 'microsoft'" Code="STYLEBRO003" Text="StyleBroStyle is '$(StyleBroStyle)': use 'stylecop' (the default), 'microsoft' or 'none'. See https://bisforboman.github.io/stylebro/styles/" />
    <Warning Condition="('$(_StyleBroStyle)' == 'microsoft' or '$(_StyleBroStyle)' == 'stylecop') and '$(_StyleBroPresetLevel)' == 'none'" Code="STYLEBRO004" Text="StyleBroStyle is ignored with StyleBroPreset none: a style sits on top of the preset. Set a preset version, or remove StyleBroStyle." />
  </Target>

  <!--
    A file-based program ('dotnet run app.cs', .NET 10) imports the repository's Directory.Build.props like any project,
    StyleBro's PackageReference included, but 'dotnet format' can't load it, so 'bro format' can't fix what the analyzers
    report there (trial 42, PolyShim: its build runs GenerateSignatures.csx with 'dotnet run', which then failed on 37
    findings with warnings as errors). Its analyzers from this package are left out (owner's decision 2026-10-22).
  -->
  <Target Name="_StyleBroLeaveFileBasedPrograms" AfterTargets="ResolveLockFileAnalyzers" BeforeTargets="CoreCompile" Condition="'$(FileBasedProgram)' == 'true'">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'StyleBro.Analyzers'" />
    </ItemGroup>
  </Target>

  <!--
    The baseline: existing violations that aren't reported (docs/baseline.md). The nearest stylebro.baseline above the
    project, or the file <StyleBroBaseline> names (it must be called stylebro.baseline); 'none' turns it off.
  -->
  <PropertyGroup>
    <StyleBroBaseline Condition="'$(StyleBroBaseline)' == ''">$([MSBuild]::GetPathOfFileAbove('stylebro.baseline', '$(MSBuildProjectDirectory)'))</StyleBroBaseline>
  </PropertyGroup>
  <!--
    A relative path ('eng/stylebro.baseline' in a Directory.Build.props) is relative to the project as MSBuild reads it, not
    to the file that set it: then it's the nearest folder at or above the project that has it, the way bro
    format finds it next to the Directory.Build.props (trial 25: format and its check said clean, the build failed).
  -->
  <PropertyGroup Condition="'$(StyleBroBaseline)' != '' and '$(StyleBroBaseline)' != 'none' and !$([System.IO.Path]::IsPathRooted('$(StyleBroBaseline)')) and !Exists('$(StyleBroBaseline)')">
    <_StyleBroBaselineFolder>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', '$(StyleBroBaseline)'))</_StyleBroBaselineFolder>
    <StyleBroBaseline Condition="'$(_StyleBroBaselineFolder)' != ''">$([System.IO.Path]::Combine('$(_StyleBroBaselineFolder)', '$(StyleBroBaseline)'))</StyleBroBaseline>
  </PropertyGroup>
  <ItemGroup Condition="'$(StyleBroBaseline)' != '' and '$(StyleBroBaseline)' != 'none' and Exists('$(StyleBroBaseline)')">
    <AdditionalFiles Include="$(StyleBroBaseline)" />
  </ItemGroup>

  <!--
    The multi-target guard (docs/modernizing.md): the project's target frameworks for MultiTargetSuppressor. Inner builds
    still see the full TargetFrameworks list. Comma-separated because ';' starts a comment in the generated editorconfig.
  -->
  <PropertyGroup>
    <StyleBroTargetFrameworks Condition="'$(StyleBroTargetFrameworks)' == '' and '$(TargetFrameworks)' != ''">$(TargetFrameworks.Replace(';', ','))</StyleBroTargetFrameworks>
    <StyleBroTargetFrameworks Condition="'$(StyleBroTargetFrameworks)' == ''">$(TargetFramework)</StyleBroTargetFrameworks>
  </PropertyGroup>
  <!--
    The package folders for PackageFileSuppressor: StyleBro's findings in files compiled from a NuGet package (source
    packages' contentFiles) are hidden, nobody can fix them there. '|'-separated, like StyleBroTargetFrameworks.
  -->
  <PropertyGroup>
    <StyleBroPackageFolders Condition="'$(StyleBroPackageFolders)' == ''">$(NuGetPackageFolders.Replace(';', '|'))</StyleBroPackageFolders>
  </PropertyGroup>
  <!--
    BRO1150 writes List<T>.Exists/Find and Array.Exists/Find where Sonar's S6605/S6602 are on: with no severity configured
    for them, that depends on the SonarAnalyzer.CSharp package's version (on in its defaults before 10.0). Its analyzer
    paths ('|'-separated; the version is in the package folder's path) are passed after the packages' analyzers are
    resolved, so this is a target.
  -->
  <Target Name="_StyleBroFindSonar" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun">
    <ItemGroup>
      <_StyleBroSonarAnalyzer Include="@(Analyzer)" Condition="'%(Filename)' == 'SonarAnalyzer.CSharp'" />
    </ItemGroup>
    <PropertyGroup>
      <StyleBroSonar Condition="'$(StyleBroSonar)' == ''">@(_StyleBroSonarAnalyzer->'%(FullPath)', '|')</StyleBroSonar>
    </PropertyGroup>
  </Target>
  <!--
    The folders source generators write to, for GeneratedFileSuppressor: the compiler puts generated files under the
    intermediate output folder (obj/), or under CompilerGeneratedFilesOutputPath when EmitCompilerGeneratedFiles is on.
    Also the files a T4 template writes (a Compile item with DependentUpon '*.tt' or AutoGen True): generated code too
    (trial 28). A target, so both paths are final. '|'-separated.
  -->
  <Target Name="_StyleBroFindGeneratedFolders" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun" Condition="'$(StyleBroGeneratedFolders)' == ''">
    <ItemGroup>
      <_StyleBroTemplateOutput Include="@(Compile)" Condition="'%(Compile.AutoGen)' == 'true' or $([System.String]::Copy('%(Compile.DependentUpon)').ToLowerInvariant().EndsWith('.tt'))" />
    </ItemGroup>
    <PropertyGroup>
      <StyleBroGeneratedFolders Condition="'$(BaseIntermediateOutputPath)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)'))))</StyleBroGeneratedFolders>
      <StyleBroGeneratedFolders Condition="'$(EmitCompilerGeneratedFiles)' == 'true' and '$(CompilerGeneratedFilesOutputPath)' != ''">$(StyleBroGeneratedFolders)|$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(CompilerGeneratedFilesOutputPath)'))))</StyleBroGeneratedFolders>
      <StyleBroGeneratedFolders Condition="'@(_StyleBroTemplateOutput)' != ''">$(StyleBroGeneratedFolders)|@(_StyleBroTemplateOutput->'%(FullPath)', '|')</StyleBroGeneratedFolders>
    </PropertyGroup>
  </Target>
  <!--
    The repository's git submodules, for PackageFileSuppressor: another repository's code a project compiles (SixLabors'
    shared-infrastructure) can't be fixed here, and 'dotnet format' skips it. Their paths come from the .gitmodules
    nearest above the project, without the ones at or above StyleBroRepositoryRoot: in a submodule's own checkout that's
    the superproject's .gitmodules, which names the submodule itself (trial 28: all of its own findings were hidden). Unless
    the build's solution (SolutionDir, set by the IDE and 'dotnet format' too) is outside that submodule: the superproject's
    solution builds the submodule's project (trial 39, MailKit.sln and MimeKit: 145,994 findings 'format' leaves alone).
    '|'-separated.
  -->
  <Target Name="_StyleBroFindSubmodules" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun" Condition="'$(StyleBroSubmoduleFolders)' == ''">
    <PropertyGroup>
      <_StyleBroGitRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', '.gitmodules'))</_StyleBroGitRoot>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_StyleBroGitRoot)/.gitmodules" Condition="'$(_StyleBroGitRoot)' != ''">
      <Output TaskParameter="Lines" ItemName="_StyleBroGitModulesLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_StyleBroSubmodule Include="$([MSBuild]::NormalizeDirectory('$(_StyleBroGitRoot)', $([System.Text.RegularExpressions.Regex]::Replace('%(_StyleBroGitModulesLine.Identity)', '^\s*path\s*=\s*', '').Trim())))" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_StyleBroGitModulesLine.Identity)', '^\s*path\s*='))" />
    </ItemGroup>
    <PropertyGroup Condition="'$(StyleBroRepositoryRoot)' != '' and '$(StyleBroRepositoryRoot)' != 'none'">
      <_StyleBroRepositoryFolder>$([MSBuild]::NormalizeDirectory('$(StyleBroRepositoryRoot)').ToUpperInvariant())</_StyleBroRepositoryFolder>
    </PropertyGroup>
    <PropertyGroup Condition="'$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">
      <_StyleBroSolutionFolder>$([MSBuild]::NormalizeDirectory('$(SolutionDir)').ToUpperInvariant())</_StyleBroSolutionFolder>
    </PropertyGroup>
    <ItemGroup Condition="'$(_StyleBroRepositoryFolder)' != ''">
      <_StyleBroSubmodule Remove="@(_StyleBroSubmodule)" Condition="$(_StyleBroRepositoryFolder.StartsWith($([System.String]::Copy('%(_StyleBroSubmodule.Identity)').ToUpperInvariant()))) and ('$(_StyleBroSolutionFolder)' == '' or $(_StyleBroSolutionFolder.StartsWith($([System.String]::Copy('%(_StyleBroSubmodule.Identity)').ToUpperInvariant()))))" />
    </ItemGroup>
    <PropertyGroup>
      <StyleBroSubmoduleFolders>@(_StyleBroSubmodule, '|')</StyleBroSubmoduleFolders>
    </PropertyGroup>
  </Target>
  <!--
    The repository's MarkdownSnippets snippet names, for BRO1112/BRO1113: a '#region Name' the docs include ('snippet: Name',
    also an in-place one in an HTML comment) stays, or the build's MarkdownSnippets step fails "Missing snippet" (trial 37,
    shouldly). Read only when an mdsnippets.json is above the project, from the markdown files (.md and .mdx) of the
    repository (else the config's folder), bin/obj/node_modules left out. Like MarkdownSnippets, the keyword's case doesn't
    matter, and 'include: Name' (in place: 'include: Name. path: ...', 'singleLineInclude: ...') takes a snippet too
    (trial 38). '|'-separated, with empty entries.
  -->
  <Target Name="_StyleBroFindSnippets" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun" Condition="'$(StyleBroSnippets)' == ''">
    <PropertyGroup>
      <_StyleBroSnippetsConfig>$([MSBuild]::GetPathOfFileAbove('mdsnippets.json', '$(MSBuildProjectDirectory)'))</_StyleBroSnippetsConfig>
      <_StyleBroSnippetsRoot Condition="'$(_StyleBroSnippetsConfig)' != '' and '$(StyleBroRepositoryRoot)' != '' and '$(StyleBroRepositoryRoot)' != 'none'">$([MSBuild]::NormalizeDirectory('$(StyleBroRepositoryRoot)'))</_StyleBroSnippetsRoot>
      <_StyleBroSnippetsRoot Condition="'$(_StyleBroSnippetsConfig)' != '' and '$(_StyleBroSnippetsRoot)' == ''">$([MSBuild]::NormalizeDirectory($([System.IO.Path]::GetDirectoryName('$(_StyleBroSnippetsConfig)'))))</_StyleBroSnippetsRoot>
    </PropertyGroup>
    <ItemGroup Condition="'$(_StyleBroSnippetsRoot)' != ''">
      <_StyleBroMarkdown Include="$(_StyleBroSnippetsRoot)**/*.md;$(_StyleBroSnippetsRoot)**/*.mdx" Exclude="$(_StyleBroSnippetsRoot)**/node_modules/**;$(_StyleBroSnippetsRoot)**/bin/**;$(_StyleBroSnippetsRoot)**/obj/**" />
    </ItemGroup>
    <ReadLinesFromFile File="%(_StyleBroMarkdown.FullPath)" Condition="'@(_StyleBroMarkdown)' != ''">
      <Output TaskParameter="Lines" ItemName="_StyleBroMarkdownLine" />
    </ReadLinesFromFile>
    <PropertyGroup Condition="'@(_StyleBroMarkdownLine)' != ''">
      <_StyleBroMarkdownText>@(_StyleBroMarkdownLine, '%0A')</_StyleBroMarkdownText>
      <StyleBroSnippets>$([System.Text.RegularExpressions.Regex]::Replace('$(_StyleBroMarkdownText)', '(?im)^(?:(?:[^\n]*?&lt;!--[ \t]*|[ \t]*)(?:snippet|include|singleLineInclude):[ \t]*([^\s&gt;|]+?)\.?(?=[\s&gt;|]|$)[^\n]*|[^\n]*)\n?', '$1|'))</StyleBroSnippets>
    </PropertyGroup>
  </Target>
  <!--
    The project's git repository, for OutsideRepositorySuppressor: StyleBro's findings in files compiled from outside it
    ('..\..\outside\Shared.cs') are hidden, 'bro format' leaves them alone. The nearest folder above the
    project with a '.git' folder (found by its HEAD) or a '.git' file (a worktree or submodule); 'none' turns it off.
  -->
  <PropertyGroup Condition="'$(StyleBroRepositoryRoot)' == ''">
    <_StyleBroGitFolderRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', '.git/HEAD'))</_StyleBroGitFolderRoot>
    <_StyleBroGitFileRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', '.git'))</_StyleBroGitFileRoot>
    <StyleBroRepositoryRoot>$(_StyleBroGitFolderRoot)</StyleBroRepositoryRoot>
    <StyleBroRepositoryRoot Condition="$(_StyleBroGitFileRoot.Length) &gt; $(_StyleBroGitFolderRoot.Length)">$(_StyleBroGitFileRoot)</StyleBroRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="StyleBroRepositoryRoot" />
    <CompilerVisibleProperty Include="StyleBroSubmoduleFolders" />
    <CompilerVisibleProperty Include="StyleBroGeneratedFolders" />
    <CompilerVisibleProperty Include="StyleBroSnippets" />
    <CompilerVisibleProperty Include="StyleBroSonar" />
    <CompilerVisibleProperty Include="StyleBroPackageFolders" />    <CompilerVisibleProperty Include="StyleBroTargetFrameworks" />
    <!-- BRO1145 (C# 12 syntax): the SDK sets LangVersion to MaxSupportedLangVersion unless the project sets it. -->
    <CompilerVisibleProperty Include="LangVersion" />
    <CompilerVisibleProperty Include="MaxSupportedLangVersion" />
    <!-- BRO1601 asks for documentation only where the project generates it (the same in a build and 'dotnet format'). -->
    <CompilerVisibleProperty Include="GenerateDocumentationFile" />
  </ItemGroup>
</Project>
