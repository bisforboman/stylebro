<Project>
  <!--
    Applies the recommended preset unless the consuming project sets <StyleBroPreset>none</StyleBroPreset>.
    This is a .targets file (not .props) so a StyleBroPreset set in the project file is already visible here.
    The preset is a global config with a low global_level: anything in the project's own
    .editorconfig or .globalconfig wins.
    It goes in EditorConfigFiles, not GlobalAnalyzerConfigFiles: the SDK turns GlobalAnalyzerConfigFiles into
    EditorConfigFiles in Microsoft.Managed.Core.targets, which is evaluated before a package's build targets, so an item
    added here was never passed to the compiler (alpha.1 to alpha.8). The compiler reads it as global (is_global = true).
  -->
  <ItemGroup Condition="'$(StyleBroPreset)' != 'none'">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)stylebro.recommended.globalconfig" />
  </ItemGroup>

  <!--
    The baseline: existing violations that aren't reported (docs/baseline.md). The nearest stylebro.baseline above the
    project, or the file <StyleBroBaseline> names (it must be called stylebro.baseline); 'none' turns it off.
  -->
  <PropertyGroup>
    <StyleBroBaseline Condition="'$(StyleBroBaseline)' == ''">$([MSBuild]::GetPathOfFileAbove('stylebro.baseline', '$(MSBuildProjectDirectory)'))</StyleBroBaseline>
  </PropertyGroup>
  <ItemGroup Condition="'$(StyleBroBaseline)' != '' and '$(StyleBroBaseline)' != 'none' and Exists('$(StyleBroBaseline)')">
    <AdditionalFiles Include="$(StyleBroBaseline)" />
  </ItemGroup>

  <!--
    The multi-target guard (docs/modernizing.md): the project's target frameworks for MultiTargetSuppressor. Inner builds
    still see the full TargetFrameworks list. Comma-separated because ';' starts a comment in the generated editorconfig.
  -->
  <PropertyGroup>
    <StyleBroTargetFrameworks Condition="'$(StyleBroTargetFrameworks)' == '' and '$(TargetFrameworks)' != ''">$(TargetFrameworks.Replace(';', ','))</StyleBroTargetFrameworks>
    <StyleBroTargetFrameworks Condition="'$(StyleBroTargetFrameworks)' == ''">$(TargetFramework)</StyleBroTargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="StyleBroTargetFrameworks" />
  </ItemGroup>
</Project>
