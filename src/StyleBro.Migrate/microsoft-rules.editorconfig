# The Microsoft style (<StyleBroStyle>microsoft</StyleBroStyle>): dotnet/runtime's build severities for the built-in rules
# whose options the style sets (its eng/CodeAnalysis.src.globalconfig; the options come from StyleBro's style layer)
# 'this.' only where needed (guide rule 4; runtime's build has it at suggestion, its guide asks for it)
dotnet_diagnostic.IDE0003.severity = warning
# 'var' only where the type is named on the right
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0008.severity = suggestion
# Pattern matching, '??', 'is null', static local functions, '?.Invoke'
dotnet_diagnostic.IDE0020.severity = warning
dotnet_diagnostic.IDE0029.severity = warning
dotnet_diagnostic.IDE0030.severity = warning
dotnet_diagnostic.IDE0041.severity = warning
dotnet_diagnostic.IDE0062.severity = warning
dotnet_diagnostic.IDE1005.severity = warning
# Shown in the IDE, not applied by 'dotnet format'
dotnet_diagnostic.IDE0017.severity = suggestion
dotnet_diagnostic.IDE0018.severity = suggestion
dotnet_diagnostic.IDE0019.severity = suggestion
dotnet_diagnostic.IDE0028.severity = suggestion
dotnet_diagnostic.IDE0034.severity = suggestion
dotnet_diagnostic.IDE0044.severity = suggestion
dotnet_diagnostic.IDE0066.severity = suggestion
dotnet_diagnostic.IDE0031.severity = silent
dotnet_diagnostic.IDE0071.severity = silent
# Runtime's .editorconfig prefers none of these
dotnet_diagnostic.IDE0039.severity = none
dotnet_diagnostic.IDE0056.severity = none
dotnet_diagnostic.IDE0057.severity = none
dotnet_diagnostic.IDE0063.severity = none
# 'nameof' instead of a string (guide rule 14); internal and private types static where they can be (guide rule 19)
dotnet_diagnostic.CA1507.severity = warning
dotnet_diagnostic.CA1052.severity = warning
# Internal and private types sealed (guide rule 19): a suggestion, not runtime's warning, because the SDK's fix seals a
# type with virtual members without removing 'virtual' (CS0549: 12 errors in Newtonsoft.Json's tests)
dotnet_diagnostic.CA1852.severity = suggestion
