<Project Sdk="Microsoft.NET.Sdk">

  <!--
    stylebro-migrate: turns a repository's StyleCop setup (rule severities and stylecop.json) into the StyleBro and
    SDK settings that enforce the same things, so switching to StyleBro doesn't change the code's style.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>stylebro-migrate</ToolCommandName>
    <PackageId>StyleBro.Migrate</PackageId>
    <!-- Released together with StyleBro.Analyzers: release.yml overrides this with the tag's version. -->
    <Version>0.5.0-alpha.1</Version>
    <Description>Generates StyleBro and .NET SDK settings from a repository's StyleCop configuration, so moving from StyleCop.Analyzers to StyleBro keeps the code's style.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bisforboman/stylebro</PackageProjectUrl>
    <PackageTags>stylecop;sonarqube;migration;analyzers;code-style;dotnet-format;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="..\StyleBro.Analyzers\StyleBro.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- StyleCop's rules with their default severities, read from the StyleCop DLLs by Get-Inventory.ps1. -->
    <EmbeddedResource Include="..\..\scripts\stylecop-survey\data\inventory-1.2.0-beta.556.csv" LogicalName="StyleCopRules.csv" />
    <EmbeddedResource Include="..\..\scripts\stylecop-survey\data\inventory-1.1.118.csv" LogicalName="StyleCopRules-1.1.118.csv" />
    <EmbeddedResource Include="..\..\scripts\stylecop-survey\data\mapping.csv" LogicalName="StyleCopMapping.csv" />
    <EmbeddedResource Include="sdk-rules.editorconfig" LogicalName="SdkRules.editorconfig" />
    <EmbeddedResource Include="modernize-rules.editorconfig" LogicalName="ModernizeRules.editorconfig" />
    <!-- Sonar's C# rules and defaults (public metadata of SonarAnalyzer.CSharp), and the rules that fix what they report. -->
    <EmbeddedResource Include="data\sonar-rules-10.35.0.4138.tsv" LogicalName="SonarRules.tsv" />
    <EmbeddedResource Include="data\sonar-mapping.tsv" LogicalName="SonarMapping.tsv" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StyleBro.Tests" />
  </ItemGroup>

</Project>