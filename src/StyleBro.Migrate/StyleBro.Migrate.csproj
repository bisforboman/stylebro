<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The 'bro' command (package StyleBro.Tool; this project keeps its old name StyleBro.Migrate): init, migrate (a
    repository's StyleCop setup into the StyleBro and SDK settings that enforce the same things), format, check, preview,
    baseline.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bro</ToolCommandName>
    <PackageId>StyleBro.Tool</PackageId>
    <!-- Released together with StyleBro.Analyzers: release.yml overrides this with the tag's version. -->
    <Version>0.7.0-alpha.1</Version>
    <Description>The bro command for StyleBro: sets a repository up (init, or migrate from StyleCop), fixes it (format, check, preview) and writes baselines.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bisforboman/stylebro</PackageProjectUrl>
    <PackageTags>stylecop;sonarqube;migration;analyzers;code-style;dotnet-format;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="..\StyleBro.Analyzers\StyleBro.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- StyleCop's rules with their default severities, read from the StyleCop DLLs by Get-Inventory.ps1. -->
    <EmbeddedResource Include="..\..\scripts\stylecop-survey\data\inventory-1.2.0-beta.556.csv" LogicalName="StyleCopRules.csv" />
    <EmbeddedResource Include="..\..\scripts\stylecop-survey\data\inventory-1.1.118.csv" LogicalName="StyleCopRules-1.1.118.csv" />
    <EmbeddedResource Include="..\..\scripts\stylecop-survey\data\inventory-1.0.2.csv" LogicalName="StyleCopRules-1.0.2.csv" />
    <EmbeddedResource Include="..\..\scripts\stylecop-survey\data\mapping.csv" LogicalName="StyleCopMapping.csv" />
    <!-- StyleSharp (a StyleCop successor, SST ids): its rules, and the StyleCop rules each stands for (New-StyleSharpMapping.ps1). -->
    <EmbeddedResource Include="..\..\scripts\stylecop-survey\data\inventory-stylesharp-5.1.2.csv" LogicalName="StyleSharpRules.csv" />
    <EmbeddedResource Include="..\..\scripts\stylecop-survey\data\stylesharp-mapping.csv" LogicalName="StyleSharpMapping.csv" />
    <EmbeddedResource Include="sdk-rules.editorconfig" LogicalName="SdkRules.editorconfig" />
    <EmbeddedResource Include="modernize-rules.editorconfig" LogicalName="ModernizeRules.editorconfig" />
    <!-- The preset's layers: init writes their severities by id where a bulk severity would hide them from 'dotnet format'. -->
    <EmbeddedResource Include="..\StyleBro.Package\build\presets\*.globalconfig" LogicalName="Preset.%(Filename)%(Extension)" />
    <!-- The Microsoft style (init with the microsoft style): its layers set the conventions' defaults, its template the severities. -->
    <EmbeddedResource Include="..\StyleBro.Package\build\presets\styles\*.globalconfig" LogicalName="Style.%(Filename)%(Extension)" />
    <EmbeddedResource Include="microsoft-rules.editorconfig" LogicalName="MicrosoftRules.editorconfig" />
    <!-- Sonar's C# rules and defaults (public metadata of SonarAnalyzer.CSharp), and the rules that fix what they report. -->
    <EmbeddedResource Include="data\sonar-rules-10.35.0.4138.tsv" LogicalName="SonarRules.tsv" />
    <EmbeddedResource Include="data\sonar-mapping.tsv" LogicalName="SonarMapping.tsv" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StyleBro.Tests" />
  </ItemGroup>

</Project>