<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Keep Roslyn low so the package loads in every SDK / Visual Studio that consumers use.
      4.8.0 = .NET 8 SDK / VS 17.8. Raise only when a rule needs a newer API.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- bro's format host compiles against these and runs on the SDK's own copies (src/StyleBro.FormatHost). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <!--
      Pin the format host's transitive packages above their advisories: System.Text.Json 7.0.3 from Workspaces.MSBuild
      (NU1903, GHSA-hh2w-p6rv-4g7w) and System.Drawing.Common 4.7.0 from Microsoft.Build.Framework 16.10 through
      System.Security.Permissions and System.Windows.Extensions (NU1904, GHSA-rxg9-xrhp-64gj). Compile-time only: the
      format host excludes their runtime assets and runs on the SDK's own copies, so no shipped package contains them.
      8.0.x matches its net8.0 target.
    -->
    <PackageVersion Include="System.Text.Json" Version="9.0.0" />
    <PackageVersion Include="System.Drawing.Common" Version="8.0.34" />

    <!-- StyleBro checks its own code with its latest published release (not the code being built). -->
    <PackageVersion Include="StyleBro.Analyzers" Version="$(StyleBroSelfVersion)" />

    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Pins the test framework's transitive System.Security.Cryptography.Pkcs above 9.0.6 (NU1903, GHSA-846f-f764-76mx). Tests only: no shipped package contains it. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
</Project>
