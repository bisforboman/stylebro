# escape=`
# Windows image for trials of Windows-only repos (WPF, WinForms, .NET Framework, old-style csproj, net4x targets).
# UNTESTED: it needs Docker in Windows-containers mode (the owner's setting; Start-TrialContainer.ps1 -Windows refuses
# otherwise). The base has .NET Framework 4.8.1 with its targeting packs and the Visual Studio Build Tools; this adds the
# .NET SDKs 10, 9 and 8 (same pinned versions as the Linux image), MinGit and PowerShell 7. Runs as ContainerAdministrator
# (the base's default; inside the container only). No GUI app can run in a container: there is no desktop.
FROM mcr.microsoft.com/dotnet/framework/sdk:4.8.1-20261013-windowsservercore-ltsc2022

SHELL ["powershell", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

RUN Invoke-WebRequest https://builds.dotnet.microsoft.com/dotnet/scripts/v1/dotnet-install.ps1 -OutFile C:\dotnet-install.ps1; `
    foreach ($sdk in '10.0.402', '9.0.319', '8.0.426') { C:\dotnet-install.ps1 -Version $sdk -InstallDir 'C:\Program Files\dotnet' -NoPath }; `
    Remove-Item C:\dotnet-install.ps1

RUN Invoke-WebRequest https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.2/MinGit-2.56.0.2-64-bit.zip -OutFile C:\mingit.zip; `
    Expand-Archive C:\mingit.zip C:\git; `
    Remove-Item C:\mingit.zip

RUN & 'C:\Program Files\dotnet\dotnet.exe' tool install --tool-path C:\pwsh PowerShell --version 7.6.5

RUN setx /M PATH ('C:\Program Files\dotnet;C:\git\cmd;C:\pwsh;C:\tools;' + $env:PATH); `
    New-Item -ItemType Directory C:\nuget, C:\work, C:\logs, C:\tools | Out-Null

RUN dotnet --list-sdks; pwsh -v; `
    git config --system --add safe.directory '*'; `
    git config --system user.name trial; `
    git config --system user.email trial@example.invalid

ENV NUGET_PACKAGES=C:\nuget `
    DOTNET_CLI_TELEMETRY_OPTOUT=1 `
    DOTNET_NOLOGO=1 `
    DiffEngine_Disabled=true
WORKDIR C:\work
CMD ["ping", "-t", "localhost"]
