<Project Sdk="Microsoft.NET.Sdk">

  <!-- A startup hook that times dotnet format's fix loop per diagnostic id (README.md, "Fix loop probe"). Not in
       StyleBro.slnx; not checked by StyleBro itself. Loaded with DOTNET_STARTUP_HOOKS into dotnet-format.dll. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StyleBroSelf>none</StyleBroSelf>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <!-- Compile against Roslyn; at run time dotnet format's own (newer) copy is used. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.8.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
